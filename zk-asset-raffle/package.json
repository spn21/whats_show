{
  "name": "zk-asset-raffle",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm -C apps/frontend dev\" \"pnpm -C apps/api dev\"",
    "dev:frontend": "pnpm -C apps/frontend dev",
    "dev:api": "pnpm -C apps/api dev",
    "build:frontend": "pnpm -C apps/frontend build",
    "lint:frontend": "pnpm -C apps/frontend lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@paulmillr/qr": "0.3.0",
      "@walletconnect/ethereum-provider": "2.23.1",
      "@walletconnect/sign-client": "2.23.1",
      "@walletconnect/universal-provider": "2.23.1"
    }
  }
}
